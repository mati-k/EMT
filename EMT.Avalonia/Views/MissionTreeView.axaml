<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EMT.ViewModels"
             x:DataType="vm:MissionTreeViewModel"
             x:Class="EMT.Views.MissionTreeView">
  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#FF1E2A3A">
    <Canvas x:Name="MainCanvas" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top"/>
  </ScrollViewer>
</UserControl>
